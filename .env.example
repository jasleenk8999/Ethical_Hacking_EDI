# Database Configuration (SQLite default for instant run, PostgreSQL supported)
DATABASE_URL=sqlite:///./caira.db

# ── LLM Provider Keys ──────────────────────────────────────────────────────────
# Set whichever key matches your chosen agent.provider in config.yaml.

# BharatCode (OpenAI-compatible endpoint) — used when agent.provider=bharatcode
BHARATCODE_API_KEY=

# Anthropic Claude — used when agent.provider=anthropic
ANTHROPIC_API_KEY=

# ── Backend Settings ───────────────────────────────────────────────────────────
FASTAPI_PORT=8000
ENVIRONMENT=development

# ── Frontend Settings ──────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api
