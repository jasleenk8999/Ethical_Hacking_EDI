# CAIRA Backend Environment Variables

# ── LLM Provider Configuration ─────────────────────────────────────────────────
# Set the provider in config.yaml (agent.provider): "anthropic" or "bharatcode"

# For Anthropic provider (default):
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# For BharatCode provider (Qwen models):
BHARATCODE_API_KEY=your-bharatcode-api-key-here

# ── Database ───────────────────────────────────────────────────────────────────
# Database URL is configured in config.yaml (database.url)
# Default: sqlite:///./caira.db
