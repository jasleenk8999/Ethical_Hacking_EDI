# CAIRA Backend Environment Variables

# ── LLM Provider Configuration ─────────────────────────────────────────────────
# Set the provider in config.yaml (agent.provider): "openai_compat" or "anthropic"

# For any OpenAI-compatible provider (BharatCode, Groq, Together AI, OpenAI, local servers…):
OPENAI_COMPAT_API_KEY=your-api-key-here

# For Anthropic provider (Claude models):
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# ── Database ───────────────────────────────────────────────────────────────────
# Database URL is configured in config.yaml (database.url)
# Default: sqlite:///./caira.db
